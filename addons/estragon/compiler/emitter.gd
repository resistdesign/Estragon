@tool
extends RefCounted
## Typed frontend -> ordinary GDScript. All output is range-mapped, never rewritten.
const Model = preload("res://addons/estragon/compiler/model.gd")
const Source = preload("res://addons/estragon/compiler/source.gd")
const MappedWriter = preload("res://addons/estragon/compiler/source_map.gd")

class Argument extends RefCounted:
	var expression: Model.GdExpression
	var type_name: String
	var name: String

class Factory extends RefCounted:
	var name: String
	var root: Model.Component
	var arguments: Array[Argument] = []

var _module: Model.Module
var _file: Source
var _writer: MappedWriter
var _factories: Array[Factory] = []
var _arguments: Dictionary = {}
var _sequence: int = 0
var _variable: int = 0

func _init(module: Model.Module, file: Source) -> void:
	_module = module
	_file = file
	_writer = MappedWriter.new(file)

func emit() -> MappedWriter:
	if _module.mode == "markup":
		var root: Model.Component = _module.parts[0]
		_writer.append("# Generated by Gogo; do not edit.\n# Source: %s\nextends EstragonSurface\n\n\nfunc _init() -> void:\n" % _string(_file.name), root.span)
		var variable := _component(root, "\t")
		_writer.append("\tset_root(%s)\n" % variable, root.span)
	else:
		_parts(_module.parts)
		_writer.append("\n")
		# Calls in argument expressions may append additional factories.
		var index: int = 0
		while index < _factories.size():
			_factory(_factories[index])
			index += 1
	_writer.finish()
	return _writer

## Escape a GDScript literal character-by-character; never touch authored code.
static func _string(value: String) -> String:
	var output := '"'
	for character in value:
		match character:
			'"': output += '\\"'
			"\\": output += "\\\\"
			"\n": output += "\\n"
			"\r": output += "\\r"
			"\t": output += "\\t"
			_:
				var point := character.unicode_at(0)
				output += "\\u%04x" % point if point < 32 else character
	return output + '"'

static func literal(value: Model.Literal) -> String:
	match value.kind:
		"string-literal": return _string(value.value)
		"integer-literal": return str(value.value)
		"boolean-literal": return "true" if value.value else "false"
		"color-literal": return "Color(%s)" % _string(value.value)
		"number-literal": return value.number_token
	return "" # Only validated literals reach the emitter.

func _argument(expression: Model.GdExpression, type_name: String, factory: Factory) -> void:
	var argument := Argument.new()
	argument.expression = expression
	argument.type_name = type_name
	argument.name = "_gogo_value_%d" % factory.arguments.size()
	factory.arguments.append(argument)
	_arguments[expression] = argument

func _collect(node: Model.Component, factory: Factory) -> void:
	for attribute in node.attributes:
		if attribute.value is Model.GdExpression: _argument(attribute.value, attribute.type_name, factory)
	for child in node.children:
		if child is Model.GdExpression: _argument(child, "EstragonDisplayObject", factory)
		else: _collect(child, factory)

func _parts(parts: Array[Model.SyntaxNode]) -> void:
	for part in parts:
		if part is Model.Code: _writer.append(_file.slice(part.span), part.span, true)
		else: _call(part)

func _call(node: Model.Component) -> void:
	var factory := Factory.new()
	while true:
		factory.name = "_gogo_build_%d" % _sequence
		_sequence += 1
		if not _module.identifiers.has(factory.name): break
	factory.root = node
	_factories.append(factory)
	_collect(node, factory)
	var multiline := factory.arguments.size() > 3
	var start := _file.line_start(node.span.start.line)
	var end := start
	while end < _file.text.length() and _file.text[end] in [" ", "\t"]: end += 1
	var base := _file.text.substr(start, end - start)
	_writer.append(factory.name + "(", node.span)
	for index in range(factory.arguments.size()):
		var argument := factory.arguments[index]
		if index > 0: _writer.append("," if multiline else ", ", node.span)
		if multiline: _writer.append("\n" + base + _module.indentation, node.span)
		_writer.append("(", argument.expression.span)
		_parts(argument.expression.parts)
		_writer.append(")", argument.expression.span)
	_writer.append(("\n" + base if multiline else "") + ")", node.span)

func _factory(factory: Factory) -> void:
	_writer.append("\n\nstatic func " + factory.name + "(", factory.root.span)
	var multiline := factory.arguments.size() > 3
	for index in range(factory.arguments.size()):
		var argument := factory.arguments[index]
		if index > 0: _writer.append("," if multiline else ", ", argument.expression.span)
		_writer.append(("\n" + _module.indentation if multiline else "") + argument.name + ": " + argument.type_name, argument.expression.span)
	_writer.append(("\n" if multiline else "") + ") -> " + factory.root.runtime_class + ":\n", factory.root.span)
	_variable = 0
	var variable := _component(factory.root, _module.indentation)
	_writer.append(_module.indentation + "return " + variable + "\n", factory.root.span)

func _line(text: String, span: Model.Span, indentation: String) -> void:
	_writer.append(indentation + text + "\n", span)

func _component(node: Model.Component, indentation: String) -> String:
	var variable := "component_%d" % _variable
	_variable += 1
	_line("var %s: %s = %s.new()" % [variable, node.runtime_class, node.runtime_class], node.span, indentation)
	for attribute in node.attributes:
		var value := attribute.value
		var argument: String = _arguments[value].name if value is Model.GdExpression else literal(value)
		if attribute.kind == "property": _line(variable + "." + attribute.name + " = " + argument, value.span, indentation)
		else:
			var error := _string("%s:%d:%d: Button.pressed requires a valid zero-argument Callable with a live target" % [_file.name, value.span.start.line, value.span.start.column])
			# Variant dispatch avoids resolving a post-4.2 API during old-engine parsing.
			var callback := "_gogo_callback_" + variable
			_line("var %s: Variant = %s" % [callback, argument], value.span, indentation)
			_line("if not %s.is_valid() or (Engine.get_version_info()[\"minor\"] >= 3 and %s.get_argument_count() != 0):" % [argument, callback], value.span, indentation)
			_line(indentation + "push_error(" + error + ")", value.span, indentation)
			_line("elif %s.get_object() is EstragonDisplayObject and (%s.get_object() as EstragonDisplayObject).is_disposed():" % [callback, callback], value.span, indentation)
			_line(indentation + "push_error(" + error + ")", value.span, indentation)
			_line("elif %s.pressed.connect(%s) != OK:" % [variable, argument], value.span, indentation)
			_line(indentation + "push_error(" + error + ")", value.span, indentation)
	for child in node.children:
		var child_value: String = _arguments[child].name if child is Model.GdExpression else _component(child, indentation)
		_line("if %s.add_child(%s) != OK:" % [variable, child_value], child.span, indentation)
		_line(indentation + "push_error(%s)" % _string("%s:%d:%d: Gogo child must be a live, uniquely owned component" % [_file.name, child.span.start.line, child.span.start.column]), child.span, indentation)
	return variable
