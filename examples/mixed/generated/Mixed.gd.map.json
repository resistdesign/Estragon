{"format":"estragon.gogo.source-map","version":1,"sourceName":"examples/mixed/Mixed.gogo","sourceContent":"extends EstragonSurface\n# Authored GDScript: literals containing markup are ordinary strings.\nconst DESCRIPTION: String = \"<Rect> is not markup inside a string\"\nvar spacing: float = 12.0\nvar header_height: float = 48.0\nvar sidebar_width: float = 120.0\nvar accent: Color = Color(\"8566e0\")\nvar constructions: int = 0\n\n\nfunc _init() -> void:\n    set_root(build_view())\n\n\nfunc make_panel(panel_width: float, color: Color) -> EstragonRect:\n    constructions += 1\n    return <Rect width={panel_width} fill_height={true} fill={color} />\n\n\nfunc build_view() -> EstragonVBox:\n    var small: bool = sidebar_width < 80.0\n    var actual_gap: float = spacing / 2.0 if small else spacing\n    return (\n        <VBox gap={actual_gap}>\n            <Rect height={header_height + 8.0} fill_width=\"true\" fill={accent} />\n            <HBox gap={spacing} fill_width={true} fill_height=\"true\">\n                {make_panel(sidebar_width, Color(\"30c9b0\"))}\n                <Rect fill_width=\"true\" fill_height={true}\n                    fill={Color(\"50466f\") if sidebar_width > 0 else Color.BLACK} />\n            </HBox>\n        </VBox>\n    )\n\n\nfunc rebuild() -> void:\n    # Explicit construction-time values, not reactive bindings.\n    set_root(build_view())\n","segments":[{"generated":{"start":{"offset":0,"line":1,"column":1},"end":{"offset":469,"line":17,"column":12}},"original":{"start":{"offset":0,"line":1,"column":1},"end":{"offset":469,"line":17,"column":12}},"kind":"copied"},{"generated":{"start":{"offset":469,"line":17,"column":12},"end":{"offset":483,"line":17,"column":26}},"original":{"start":{"offset":469,"line":17,"column":12},"end":{"offset":529,"line":17,"column":72}},"kind":"generated"},{"generated":{"start":{"offset":483,"line":17,"column":26},"end":{"offset":484,"line":17,"column":27}},"original":{"start":{"offset":481,"line":17,"column":2