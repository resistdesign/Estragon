<?xml version="1.0" encoding="UTF-8"?>
<!-- Gogo UI components are NOT Godot Control nodes. -->
<gogo:View xmlns:gogo="urn:estragon:gogo:1"
           id="main" width="960" height="540">
    <gogo:Rect id="background" x="0" y="0"
               width="960" height="540" fill="#131725" />
    <gogo:Rect id="accent" x="48" y="48"
               width="480" height="128" fill="#8566e0" />
    <gogo:Rect id="highlight" x="48" y="198"
               width="660" height="14" fill="#65dccb" />
</gogo:View>
